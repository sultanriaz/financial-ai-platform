DATABASE_URL=postgresql+asyncpg://financial:financial@localhost:5432/financial_ai
KAFKA_URL=localhost:9092
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest
RSS_INTERVAL_SECONDS=15
API_HOST=0.0.0.0
API_PORT=8000

# Used by docker-compose.yml (Compose reads this file automatically for
# ${...} substitution) — both default to the values below if left unset.
POSTGRES_PASSWORD=financial
# Only needed if running `docker compose --profile local-ai up -d ollama`;
# points finai-consumer at the bundled container instead of a host install.
# OLLAMA_URL=http://ollama:11434
